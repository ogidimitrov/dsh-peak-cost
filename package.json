{
  "name": "dsh-peak-cost",
  "version": "1.4.0",
  "description": "DeepSeek Harness plugin: peak-hours status, session spend with per-content cost attribution, and account balance, under the composer.",
  "type": "module",
  "license": "MIT",
  "author": "ogidimitrov",
  "homepage": "https://github.com/ogidimitrov/dsh-peak-cost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogidimitrov/dsh-peak-cost.git"
  },
  "bugs": {
    "url": "https://github.com/ogidimitrov/dsh-peak-cost/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-bundle",
    "plugin",
    "deepseek",
    "pricing",
    "cost"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "screenshots.json"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-manifest.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
